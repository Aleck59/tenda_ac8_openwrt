#!/bin/sh
# Generation of /etc/config/wireless when the radio driver rtl8192cd appears.
# Modeled after the vendor's broadcom-wl (etc/hotplug.d/net/00-broadcom-wifi-detect): for
# non-cfg80211 drivers do not receive the ieee80211 event, so we cling to the netdev event.
#
# The filter selects only the radios themselves (wlan0, wlan1), but not their VAP/WDS interfaces
# (wlan0-va0, wlan0-wds0 and others) - otherwise `wifi config` would twitch more than twenty times.
# The detect function itself is still idempotent.
#
# Loading order on the Tenda AC8: /etc/init.d/ac8-wifi (START=99) loads the driver at the end
# of the boot, here this event comes; ac8-wifi then runs `wifi config` itself (under the same
# lock, so that the two do not add the same radio twice) and `wifi up`.

case "$ACTION:$INTERFACE" in
	add:wlan[0-9])
		lock /var/lock/rtl8192cd-detect
		/sbin/wifi config
		lock -u /var/lock/rtl8192cd-detect
	;;
esac
