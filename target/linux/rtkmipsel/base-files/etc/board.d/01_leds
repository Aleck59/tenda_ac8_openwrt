#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
tenda,ac8-v1*)
	# SYS is the status LED (/etc/diag.sh), the port LEDs belong to the
	# RTL8367RB.  wlan0 is the 2.4 GHz radio.
	ucidef_set_led_netdev "wlan" "WLAN" "blue:wlan" "wlan0" "link tx rx"
	;;
esac

board_config_flush

exit 0
