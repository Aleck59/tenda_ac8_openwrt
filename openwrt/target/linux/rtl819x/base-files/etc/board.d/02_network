. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

rtl819x_setup_interfaces()
{
	local board="$1"

	case "$board" in
	tenda,ac8-v1)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "wan"
		;;
	*)
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

rtl819x_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	tenda,ac8-v1)
		# stock firmware uses et0macaddr for both LAN and WAN
		lan_mac=$(mtd_get_mac_ascii factory et0macaddr)
		if [ -n "$lan_mac" ]; then
			label_mac=$lan_mac
		else
			# reference factory block without MACs (release full image):
			# a random locally administered address, kept in the config
			lan_mac=$(macaddr_random)
		fi
		wan_mac=$lan_mac
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
}

board_config_update
board=$(board_name)
rtl819x_setup_interfaces $board
rtl819x_setup_macs $board
board_config_flush

exit 0
