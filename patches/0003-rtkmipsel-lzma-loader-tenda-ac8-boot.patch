Subject: [PATCH] rtkmipsel: lzma-loader: boot the kernel from the Tenda AC8 boot loader

The AC8 boot loader jumps to the image with a0 = 0x8000ffe0 and
a1 = 0x10000, the arguments of its last cache flush.  The loader took them
for argc/argv and wrote the command line pointer to 0x0004ff80, an unmapped
address: the boot ended in a TLB exception instead of a kernel start (boot
loop on the AC8).
Pass the kernel an argv of the loader instead (argc 2, argv[1] = command
line), as the OpenWrt 24.10 loader of this port does.

Also for the AC8: stop the SoC watchdog, which the boot loader leaves
running, as the first thing in head.S; reserve the o32 argument save area
below _stack, where the LZMA workspace starts; and take the VG UART register
for every chip ID but that of the plain RTL8197F.

---
diff --git a/target/linux/rtkmipsel/image/lzma-loader/src/board.c b/target/linux/rtkmipsel/image/lzma-loader/src/board.c
index 62fb161..37514e5 100644
--- a/target/linux/rtkmipsel/image/lzma-loader/src/board.c
+++ b/target/linux/rtkmipsel/image/lzma-loader/src/board.c
@@ -38,8 +38,17 @@
 
 static unsigned int uart_thr(void)
 {
+#ifdef CONFIG_BOARD_TENDA_AC8
+	/*
+	 * RTL8197FH-VG: as in rtkload of the vendor SDK, only the plain
+	 * RTL8197F uses the +0x024 alias, every other ID the +0x000 register.
+	 */
+	if ((REG32(BSP_ECO_SN) & 0xFFFFF000) != 0x8197F000)
+		return UART_THR_8197F_VG;
+#else
 	if ((REG32(BSP_ECO_SN) & 0xFFFFF000) == 0x81970000)
 		return UART_THR_8197F_VG;
+#endif
 
 	return UART_THR_8197F;
 }
diff --git a/target/linux/rtkmipsel/image/lzma-loader/src/head.S b/target/linux/rtkmipsel/image/lzma-loader/src/head.S
index 543996a..87564a0 100644
--- a/target/linux/rtkmipsel/image/lzma-loader/src/head.S
+++ b/target/linux/rtkmipsel/image/lzma-loader/src/head.S
@@ -31,6 +31,25 @@ LEAF(startup)
 	.set noreorder
 	.set mips32
 
+#ifdef CONFIG_BOARD_TENDA_AC8
+	/*
+	 * The boot loader of the Tenda AC8 leaves the SoC watchdog running,
+	 * and the kernel has no driver to feed it.  Stop it first, the way
+	 * the Realtek SDK does (rtl819x_wdt_stop(): kick, then the disable
+	 * magic), so that a hang later on stays a hang on the console
+	 * instead of a reboot.
+	 */
+	li	t0, 0xb800311c		# WDTCNR
+	lw	t1, 0(t0)
+	li	t2, 0x00800000		# WDT_CLEAR
+	or	t1, t1, t2
+	sw	t1, 0(t0)
+	sync
+	li	t1, 0xa5000000		# WDT_STOP
+	sw	t1, 0(t0)
+	sync
+#endif
+
 	mtc0	zero, CP0_WATCHLO	# clear watch registers
 	mtc0	zero, CP0_WATCHHI
 	mtc0	zero, CP0_CAUSE		# clear before writing status register
@@ -109,6 +128,12 @@ __bss_check:
 	/* Setup new "C" stack */
 	la	sp, _stack
 
+	/*
+	 * Reserve the o32 argument save area for a0-a3 of loader_main():
+	 * the LZMA workspace starts at _stack.
+	 */
+	subu	sp, 16
+
 	/* jump to the decompressor routine */
 	la	t0, loader_main
 	jr	t0
diff --git a/target/linux/rtkmipsel/image/lzma-loader/src/loader.c b/target/linux/rtkmipsel/image/lzma-loader/src/loader.c
index 535b3e2..8e3c2c2 100644
--- a/target/linux/rtkmipsel/image/lzma-loader/src/loader.c
+++ b/target/linux/rtkmipsel/image/lzma-loader/src/loader.c
@@ -80,6 +80,24 @@ static unsigned long lzma_datasize;
 static unsigned long lzma_outsize;
 static unsigned long kernel_la;
 
+#ifdef CONFIG_KERNEL_CMDLINE
+/*
+ * The kernel gets its own argc/argv: a0/a1 of the boot loader are not an
+ * argument vector on every board.  The Tenda AC8 boot loader jumps to the
+ * image with a0 = 0x8000ffe0 and a1 = 0x10000, the arguments of its last
+ * cache flush; appending the command line to "argv" a1 wrote to 0x0004ff80,
+ * an unmapped kuseg address, and the boot ended in a TLB exception instead
+ * of a kernel start.  prom_init_cmdline() skips the NULL argv[0].
+ */
+#define kernel_argc	2
+static const char kernel_cmdline[] = CONFIG_KERNEL_CMDLINE;
+static const char *const kernel_argv[] = {
+	NULL,
+	kernel_cmdline,
+	NULL,
+};
+#endif /* CONFIG_KERNEL_CMDLINE */
+
 static void halt(void)
 {
 	printf("\nSystem halted!\n");
@@ -268,8 +286,8 @@ void loader_main(unsigned long reg_a0, unsigned long reg_a1,
 	printf("Starting kernel at %08x...\n\n", kernel_la);
 
 #ifdef CONFIG_KERNEL_CMDLINE
-	((char **)reg_a1)[reg_a0] = CONFIG_KERNEL_CMDLINE;
-	reg_a0++;
+	reg_a0 = kernel_argc;
+	reg_a1 = (unsigned long) kernel_argv;
 	reg_a2 = 0;
 	reg_a3 = 0;
 #endif
