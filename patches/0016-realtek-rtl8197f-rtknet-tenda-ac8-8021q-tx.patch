Subject: [PATCH] realtek: rtl8197f-rtknet: keep the 802.1Q tag on P0 for the Tenda AC8

The AC8 runs an 802.1Q trunk to its RTL8367RB-VB (swconfig, VLAN 1 WAN /
VLAN 2 LAN, switch port 6 tagged).  Frames from the switch reach the SoC
with their tag, but rtknet fills the TX descriptor without VLAN fields:
vlantagset (opts2[8:0]) 0, so the rtl865x egress sends the frame untagged
on P0.  On hardware the switch counted all 200 test frames as good, put
them in the PVID VLAN of its port 6 and dropped every one.

For a frame that carries an 802.1Q header, set vlantagset to P0 and dvid
(opts3[11:0]) to its VID; opts1 vi[28] marks the in-frame VLAN header.
The runtime parameter ac8_tx_vlan selects the variant (0 old behaviour,
1 in-frame tag + vi, default, 2 in-frame tag without vi, 3 tag removed
and inserted by P0), so the boot check can find the one the hardware
takes.

---
--- a/target/linux/realtek/files-6.6/drivers/net/ethernet/rtl8197f_rtknet.c
+++ b/target/linux/realtek/files-6.6/drivers/net/ethernet/rtl8197f_rtknet.c
@@ -402,6 +402,13 @@
 #define RTL_RTK_TX_PH_LEN_SHIFT		6
 #define RTL_RTK_TX_M_LEN_SHIFT		15
 #define RTL_RTK_TX_DP_EXT_SHIFT		12
+/* New_swNic TX descriptor VLAN fields (SDK names): opts1 vi[28] (frame
+ * carries a VLAN header), opts2 vlantagset[8:0] (egress ports that keep or
+ * get the tag), opts3 dvid[11:0] (the VLAN id).
+ */
+#define RTL_RTK_TX_VI			BIT(28)
+#define RTL_RTK_TX_VLANTAGSET_MASK	0x1ff
+#define RTL_RTK_TX_DVID_MASK		0xfff
 #define RTL_RTK_TX_DP_EXT_MASK		0x7
 #define RTL_RTK_TX_DP_SHIFT		24
 #define RTL_RTK_TX_DP_MASK		0x7f
@@ -467,6 +474,21 @@
 module_param_named(ac8_p0_pad_rd05, ac8_p0_pad_rd05, int, 0644);
 MODULE_PARM_DESC(ac8_p0_pad_rd05, "Tenda AC8 P0 RGMII pads: 0 stock AC8 (bits 25/22/21 clear), 1 RD05 (set)");
 
+/*
+ * Tenda AC8: LAN and WAN reach the RTL8367 over an 802.1Q trunk (swconfig,
+ * VLAN 1 WAN / VLAN 2 LAN, port 6 tagged).  A descriptor without VLAN fields
+ * (vlantagset 0) makes the rtl865x egress send the frame UNTAGGED on P0: the
+ * switch counts every frame as good, puts it in the PVID VLAN of port 6 and
+ * drops it.  For a frame that carries an 802.1Q header:
+ *   0  no VLAN fields (the old behaviour)
+ *   1  tag left in the frame, vi + vlantagset P0 + dvid (default)
+ *   2  tag left in the frame, vlantagset P0 + dvid, no vi
+ *   3  tag taken out of the frame, P0 inserts it: vlantagset P0 + dvid
+ */
+static int ac8_tx_vlan = 1;
+module_param_named(ac8_tx_vlan, ac8_tx_vlan, int, 0644);
+MODULE_PARM_DESC(ac8_tx_vlan, "Tenda AC8 802.1Q TX: 0 no descriptor VLAN fields, 1 in-frame tag + vi + vlantagset P0 + dvid, 2 in-frame tag + vlantagset P0 + dvid, 3 P0 inserts the tag");
+
 static atomic_t rd05_txdesc_trace_count = ATOMIC_INIT(0);
 
 
@@ -605,6 +627,7 @@
 	bool legacy_rd05_pipeline;
 	bool sdk_crc_lengths;
 	bool p0_cpu_tag_passthrough;
+	bool ac8_board;
 	u32 rx_poll_ms;
 	struct timer_list rx_poll_timer;
 	struct delayed_work rd05_reseed_work;
@@ -4105,6 +4128,8 @@
 	u32 tx_cdp_before;
 	struct rtl8197f_rtk_txmeta txm;
 	unsigned long flags;
+	int tx_vlan_mode = 0;
+	u16 tx_vid = 0;
 
 	if (skb->len > ndev->mtu + ETH_HLEN + VLAN_HLEN) {
 		priv->tx_mtu_drops++;
@@ -4113,6 +4138,29 @@
 		return NETDEV_TX_OK;
 	}
 
+	if (priv->ac8_board) {
+		struct vlan_ethhdr *veth = (struct vlan_ethhdr *)skb->data;
+
+		tx_vlan_mode = READ_ONCE(ac8_tx_vlan);
+		if (tx_vlan_mode < 1 || tx_vlan_mode > 3 ||
+		    skb->len < VLAN_ETH_HLEN ||
+		    veth->h_vlan_proto != htons(ETH_P_8021Q)) {
+			tx_vlan_mode = 0;
+		} else {
+			tx_vid = ntohs(veth->h_vlan_TCI) & VLAN_VID_MASK;
+			if (tx_vlan_mode == 3) {
+				if (skb_ensure_writable(skb, VLAN_ETH_HLEN)) {
+					ndev->stats.tx_dropped++;
+					dev_kfree_skb_any(skb);
+					return NETDEV_TX_OK;
+				}
+				memmove(skb->data + VLAN_HLEN, skb->data,
+					2 * ETH_ALEN);
+				skb_pull(skb, VLAN_HLEN);
+			}
+		}
+	}
+
 	/*
 	 * The rtl865x TX DMA engine does not safely synthesize Ethernet padding
 	 * for runt frames.  Pad before mapping so the descriptor length never
@@ -4177,6 +4225,10 @@
 	opts4 = (txm.port_mask & RTL_RTK_TX_DP_MASK) << RTL_RTK_TX_DP_SHIFT;
 	opts5 = (txm.extspa & RTL_RTK_TX_EXTSPA_MASK) <<
 		 RTL_RTK_TX_EXTSPA_SHIFT;
+	if (tx_vlan_mode) {
+		opts2 |= BIT(0) & RTL_RTK_TX_VLANTAGSET_MASK;	/* P0 */
+		opts3 |= tx_vid & RTL_RTK_TX_DVID_MASK;
+	}
 	desc->opts2 = cpu_to_le32(opts2);
 	desc->opts3 = cpu_to_le32(opts3);
 	desc->opts4 = cpu_to_le32(opts4);
@@ -4189,6 +4241,8 @@
 		opts1 |= RTL_RTK_TX_HWLKUP;
 	if (txm.bridge)
 		opts1 |= RTL_RTK_TX_BRIDGE;
+	if (tx_vlan_mode == 1)
+		opts1 |= RTL_RTK_TX_VI;
 	/* OEM New_swNic does not set TX EOR when DMA_CR1/DMA_CR4 tail-aware
 	 * mode is active. Keep the generic wrap bit for other boards only.
 	 */
@@ -5148,6 +5202,7 @@
 					       &priv->rx_poll_ms, 10, 1000);
 	}
 
+	priv->ac8_board = of_machine_is_compatible("tenda,ac8-v1");
 	if (rtl8197f_rtk_rd05_class()) {
 		priv->rx_poll_fallback = true;
 		priv->sdk_trxrdy = true;
