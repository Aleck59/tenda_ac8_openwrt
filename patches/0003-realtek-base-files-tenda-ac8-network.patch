Subject: [PATCH] realtek: base-files: add Tenda AC8 v1 network, Wi-Fi defaults, LEDs and sysupgrade

---
--- a/target/linux/realtek/base-files/etc/board.d/01_leds
+++ b/target/linux/realtek/base-files/etc/board.d/01_leds
@@ -7,6 +7,12 @@
 board_config_update
 
 case $board in
+tenda,ac8-v1|\
+tenda,ac8-v1-8m|\
+tenda,ac8-v1-16m)
+	# SYS is the status LED (DTS aliases), WAN/LAN are RTL8367RB port LEDs.
+	ucidef_set_led_netdev "wlan" "WLAN" "blue:wlan" "wlan0" "link tx rx"
+	;;
 xiaomi,r4-rd05)
         # RTL8197F/RD05 GPIO LED assignments are not validated yet.
         # Keep first-boot defaults empty to avoid driving unknown pins.
--- a/target/linux/realtek/base-files/etc/board.d/02_network
+++ b/target/linux/realtek/base-files/etc/board.d/02_network
@@ -57,6 +57,17 @@
 esac
 
 case $board in
+tenda,ac8-v1|\
+tenda,ac8-v1-8m|\
+tenda,ac8-v1-16m)
+	# rtl819x (the DIR-842 R1 driver) hands the jacks to Linux by VLAN:
+	# VID 1 = WAN (switch port 4) as eth0.1, VID 2 = LAN (ports 0-3) as
+	# eth0.2, and the rtl8367b swconfig VLANs must use the same numbers.
+	# The VLAN number is the order of the roles: wan first.  The AC8 has
+	# three LAN jacks; the jack mapping is not verified yet.
+	ucidef_add_switch "switch0" \
+		"4:wan" "0:lan" "1:lan" "2:lan" "3:lan" "6t@eth0"
+	;;
 tenda,nova-mw5)
 	# The MW5 is a two-port DSA router, not a managed-switch platform.  Do not
 	# create the target-wide "switch" bridge with switch.1/switch.2 bridge VLAN
@@ -107,6 +118,16 @@
 	lan_mac="$label_mac"
 	[ -n "$lan_mac" ] && wan_mac=$(macaddr_add "$lan_mac" 2)
 	;;
+tenda,ac8-v1|\
+tenda,ac8-v1-8m|\
+tenda,ac8-v1-16m)
+	# Tenda "FLSH" key=value store at 0x1c000 in the boot area:
+	# et0macaddr (LAN, label), wl0_hwaddr (5 GHz), wl1_hwaddr (2.4 GHz).
+	# The stock firmware uses et0macaddr for WAN as well (wan0_hwaddr), and
+	# so does eth0.1, a VLAN of eth0.
+	label_mac=$(mtd_get_mac_ascii boot et0macaddr)
+	lan_mac="$label_mac"
+	;;
 hpe,1920-8g|\
 hpe,1920-8g-poe-65w|\
 hpe,1920-8g-poe-180w|\
@@ -219,6 +240,18 @@
 	;;
 esac
 
+case $board in
+tenda,ac8-v1|\
+tenda,ac8-v1-8m|\
+tenda,ac8-v1-16m)
+	# Wi-Fi on from the first boot: "wifi config" (mac80211.uc) gives these
+	# to the radios it adds to /etc/config/wireless.  Without a country it
+	# would leave the 5 GHz radio disabled.
+	ucidef_set_country "RU"
+	ucidef_set_wireless all "Openwrt" "psk2" "12345678"
+	;;
+esac
+
 board_config_flush
 
 exit 0
--- a/target/linux/realtek/base-files/lib/upgrade/platform.sh
+++ b/target/linux/realtek/base-files/lib/upgrade/platform.sh
@@ -20,6 +20,16 @@
 }
 
 platform_check_image() {
+	case "$(board_name)" in
+	tenda,ac8-v1*)
+		# cs6c header of the Realtek boot loader: the image is written to
+		# the firmware partition at 0x20000 as it is.
+		[ "$(get_magic_long "$1")" = "63733663" ] || {
+			echo "Invalid image type: no cs6c header."
+			return 1
+		}
+		;;
+	esac
 	return 0
 }
 
@@ -32,7 +42,8 @@
 	tenda,lynx-rtl8197f)
                 PART_NAME="kernel:rootfs"
                 ;;
-        tenda,nova-mw5)
+        tenda,nova-mw5|\
+        tenda,ac8-v1*)
                 PART_NAME="firmware"
                 ;;
         esac
