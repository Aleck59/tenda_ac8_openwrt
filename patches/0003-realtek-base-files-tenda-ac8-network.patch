Subject: [PATCH] realtek: base-files: add Tenda AC8 v1 network layout

---
--- a/target/linux/realtek/base-files/etc/board.d/02_network
+++ b/target/linux/realtek/base-files/etc/board.d/02_network
@@ -54,6 +54,16 @@
 	lan_list="lan1 lan2 lan3 lan4"
 	wan_list="wan"
 	;;
+
+tenda,ac8-v1|\
+	tenda,ac8-v1-8m|\
+	tenda,ac8-v1-16m)
+	# RTL8367RB: switch ports 0..3 are published as lan1..lan4 and port 4
+	# as wan.  The AC8 has only three LAN jacks; the jack mapping is not
+	# verified yet.
+	lan_list="lan1 lan2 lan3 lan4"
+	wan_list="wan"
+	;;
 esac
 
 case $board in
@@ -71,6 +81,9 @@
 	case $board in
 	xiaomi,r4-rd05|\
 	tenda,ac23|\
+	tenda,ac8-v1|\
+	tenda,ac8-v1-8m|\
+	tenda,ac8-v1-16m|\
 		tenda,lynx-rtl8197f)
 		# If only the native CPU port exists, do not invent a missing WAN device.
 		[ "$lan_list" = "eth0" ] || ucidef_set_interfaces_lan_wan "$lan_list" "${wan_list:-wan}"
