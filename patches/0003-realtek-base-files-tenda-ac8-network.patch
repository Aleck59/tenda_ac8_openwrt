Subject: [PATCH] realtek: base-files: add Tenda AC8 v1 network, LEDs and sysupgrade

---
--- a/target/linux/realtek/base-files/etc/board.d/01_leds
+++ b/target/linux/realtek/base-files/etc/board.d/01_leds
@@ -7,6 +7,13 @@
 board_config_update
 
 case $board in
+tenda,ac8-v1|\
+tenda,ac8-v1-8m|\
+tenda,ac8-v1-16m)
+	ucidef_set_led_netdev "wan" "WAN" "blue:wan" "wan" "link tx rx"
+	ucidef_set_led_netdev "lan" "LAN" "blue:lan" "br-lan" "link tx rx"
+	ucidef_set_led_netdev "wlan" "WLAN" "blue:wlan" "wlan0" "link tx rx"
+	;;
 xiaomi,r4-rd05)
         # RTL8197F/RD05 GPIO LED assignments are not validated yet.
         # Keep first-boot defaults empty to avoid driving unknown pins.
--- a/target/linux/realtek/base-files/etc/board.d/02_network
+++ b/target/linux/realtek/base-files/etc/board.d/02_network
@@ -54,6 +54,16 @@
 	lan_list="lan1 lan2 lan3 lan4"
 	wan_list="wan"
 	;;
+
+tenda,ac8-v1|\
+	tenda,ac8-v1-8m|\
+	tenda,ac8-v1-16m)
+	# RTL8367RB: switch ports 0..3 are published as lan1..lan4 and port 4
+	# as wan.  The AC8 has only three LAN jacks; the jack mapping is not
+	# verified yet.
+	lan_list="lan1 lan2 lan3 lan4"
+	wan_list="wan"
+	;;
 esac
 
 case $board in
@@ -71,6 +81,9 @@
 	case $board in
 	xiaomi,r4-rd05|\
 	tenda,ac23|\
+	tenda,ac8-v1|\
+	tenda,ac8-v1-8m|\
+	tenda,ac8-v1-16m|\
 		tenda,lynx-rtl8197f)
 		# If only the native CPU port exists, do not invent a missing WAN device.
 		[ "$lan_list" = "eth0" ] || ucidef_set_interfaces_lan_wan "$lan_list" "${wan_list:-wan}"
@@ -107,6 +120,16 @@
 	lan_mac="$label_mac"
 	[ -n "$lan_mac" ] && wan_mac=$(macaddr_add "$lan_mac" 2)
 	;;
+tenda,ac8-v1|\
+tenda,ac8-v1-8m|\
+tenda,ac8-v1-16m)
+	# Tenda "FLSH" key=value store at 0x1c000 in the boot area:
+	# et0macaddr (LAN, label), wl0_hwaddr (5 GHz), wl1_hwaddr (2.4 GHz).
+	# The stock firmware uses et0macaddr for WAN as well (wan0_hwaddr).
+	label_mac=$(mtd_get_mac_ascii boot et0macaddr)
+	lan_mac="$label_mac"
+	wan_mac="$label_mac"
+	;;
 hpe,1920-8g|\
 hpe,1920-8g-poe-65w|\
 hpe,1920-8g-poe-180w|\
--- a/target/linux/realtek/base-files/lib/upgrade/platform.sh
+++ b/target/linux/realtek/base-files/lib/upgrade/platform.sh
@@ -20,6 +20,16 @@
 }
 
 platform_check_image() {
+	case "$(board_name)" in
+	tenda,ac8-v1*)
+		# cs6c header of the Realtek boot loader: the image is written to
+		# the firmware partition at 0x20000 as it is.
+		[ "$(get_magic_long "$1")" = "63733663" ] || {
+			echo "Invalid image type: no cs6c header."
+			return 1
+		}
+		;;
+	esac
 	return 0
 }
 
@@ -32,7 +42,8 @@
 	tenda,lynx-rtl8197f)
                 PART_NAME="kernel:rootfs"
                 ;;
-        tenda,nova-mw5)
+        tenda,nova-mw5|\
+        tenda,ac8-v1*)
                 PART_NAME="firmware"
                 ;;
         esac
