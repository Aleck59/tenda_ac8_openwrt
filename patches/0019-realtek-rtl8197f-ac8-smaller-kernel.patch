Subject: [PATCH] realtek: rtl8197f: leave out kernel parts the Tenda AC8 does not use

The AC8 image (kernel + SquashFS) took 7.0 of the 7.75 MiB firmware
window of the 8 MiB flash, which left ~0.7 MiB for the JFFS2 overlay.
The LZMA kernel alone was 2.9 MB; the subtarget config built in, for
hardware this board does not have or drivers it does not use:

- USB host (EHCI/OHCI, RTL8197F USB PHY): the AC8 has no USB port;
- I2C, SPI master: no I2C devices, the flash is read through the SoC's
  SPI window by MTD_RTL8197F_SPIROM, not an SPI controller driver;
- CFI/JEDEC parallel flash, raw and SPI NAND, the firmware splitters of
  TP-Link/Broadcom/EVA/H3C/uImage;
- DSA with the Realtek taggers and drivers (and devlink with it): the
  RTL8367RB-VB is driven by swconfig rtl8367b;
- the Marvell PHY driver;
- the bpf() syscall (eBPF maps, verifier, cgroup hooks, ~580 KB of code):
  the firewall is nftables, nothing in the image loads eBPF programs.

MPTCP and the cgroup BPF hooks are switched off in the OpenWrt .config.

---
--- a/target/linux/realtek/rtl8197f/config-6.6
+++ b/target/linux/realtek/rtl8197f/config-6.6
@@ -16,13 +16,8 @@
 CONFIG_CPUFREQ_DT_PLATDEV=y
 CONFIG_HAVE_PCI=y
 CONFIG_PCI=y
-CONFIG_USB_SUPPORT=y
-CONFIG_USB=y
-CONFIG_USB_EHCI_HCD=y
-CONFIG_USB_EHCI_HCD_PLATFORM=y
-CONFIG_USB_OHCI_HCD=y
-CONFIG_USB_OHCI_HCD_PLATFORM=y
-CONFIG_USB_RTL8197F_HOST=y
+# Tenda AC8 image size: the board has no USB port.
+# CONFIG_USB_SUPPORT is not set
 # CONFIG_CPU_FREQ is not set
 # CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
 # CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
@@ -99,12 +94,7 @@
 CONFIG_HAS_IOPORT_MAP=y
 CONFIG_HWMON=y
 CONFIG_HZ_PERIODIC=y
-CONFIG_I2C=y
-CONFIG_I2C_ALGOBIT=y
-CONFIG_I2C_BOARDINFO=y
-CONFIG_I2C_CHARDEV=y
-CONFIG_I2C_GPIO=y
-CONFIG_I2C_MUX=y
+# CONFIG_I2C is not set
 CONFIG_INITRAMFS_SOURCE=""
 CONFIG_IRQCHIP=y
 CONFIG_IRQ_DOMAIN=y
@@ -116,7 +106,7 @@
 CONFIG_LIBFDT=y
 CONFIG_LOCK_DEBUGGING_SUPPORT=y
 CONFIG_MACH_REALTEK_RTL=y
-CONFIG_MARVELL_PHY=y
+# CONFIG_MARVELL_PHY is not set
 CONFIG_MDIO_BITBANG=y
 CONFIG_MDIO_BUS=y
 CONFIG_MDIO_DEVICE=y
@@ -136,23 +126,21 @@
 # CONFIG_MIPS_NO_APPENDED_DTB is not set
 CONFIG_MIPS_SPRAM=y
 CONFIG_MODULES_USE_ELF_REL=y
-CONFIG_MTD_CFI_ADV_OPTIONS=y
-CONFIG_MTD_CFI_GEOMETRY=y
-CONFIG_MTD_JEDECPROBE=y
-CONFIG_MTD_NAND_CORE=y
-CONFIG_MTD_NAND_ECC_SW_BCH=y
-CONFIG_MTD_NAND_ECC_SW_HAMMING=y
-CONFIG_MTD_RAW_NAND=y
-CONFIG_MTD_SPI_NAND=y
-CONFIG_MTD_SPLIT_BRNIMAGE_FW=y
-CONFIG_MTD_SPLIT_EVA_FW=y
-CONFIG_MTD_SPLIT_H3C_VFS=y
-CONFIG_MTD_SPLIT_TPLINK_FW=y
-CONFIG_MTD_SPLIT_UIMAGE_FW=y
+# Tenda AC8 image size: SPI NOR through the SoC read window
+# (MTD_RTL8197F_SPIROM), no CFI/JEDEC parallel flash, no NAND, no
+# firmware formats of other vendors.
+# CONFIG_MTD_CFI is not set
+# CONFIG_MTD_JEDECPROBE is not set
+# CONFIG_MTD_RAW_NAND is not set
+# CONFIG_MTD_SPI_NAND is not set
+# CONFIG_MTD_SPLIT_BRNIMAGE_FW is not set
+# CONFIG_MTD_SPLIT_EVA_FW is not set
+# CONFIG_MTD_SPLIT_H3C_VFS is not set
+# CONFIG_MTD_SPLIT_TPLINK_FW is not set
+# CONFIG_MTD_SPLIT_UIMAGE_FW is not set
 CONFIG_MTD_VIRT_CONCAT=y
 CONFIG_NEED_DMA_MAP_STATE=y
 CONFIG_NEED_PER_CPU_KM=y
-CONFIG_NET_DEVLINK=y
 CONFIG_NET_SELFTESTS=y
 CONFIG_NO_EXCEPT_FILL=y
 CONFIG_NVMEM=y
@@ -179,7 +167,6 @@
 CONFIG_REALTEK_PHY=y
 CONFIG_REALTEK_PHY_HWMON=y
 CONFIG_REGMAP=y
-CONFIG_REGMAP_I2C=y
 CONFIG_REGMAP_MDIO=y
 CONFIG_RESET_CONTROLLER=y
 # CONFIG_RTL838X is not set
@@ -261,9 +248,7 @@
 CONFIG_SERIAL_8250=y
 CONFIG_SERIAL_8250_CONSOLE=y
 CONFIG_SERIAL_OF_PLATFORM=y
-CONFIG_SPI=y
-CONFIG_SPI_MASTER=y
-CONFIG_SPI_MEM=y
+# CONFIG_SPI is not set
 # CONFIG_SPI_RTL8197F_SHEIPA is not set
 # CONFIG_GPIO_PCA953X is not set
 # CONFIG_GPIO_PCA953X_IRQ is not set
@@ -318,16 +303,9 @@
 CONFIG_GPIO_RTL8197F=y
 
 # RTL8197F + RTL8367 external switch integration for Linux 6.6.114
-# Prefer the in-kernel Realtek DSA stack for RTL8367R/RB/RB-VC boards.
+# The Tenda AC8 drives its RTL8367RB-VB with swconfig (below), not DSA.
 CONFIG_NET_SWITCHDEV=y
-CONFIG_NET_DSA=y
-CONFIG_NET_DSA_TAG_RTL4_A=y
-CONFIG_NET_DSA_TAG_RTL8_4=y
-CONFIG_NET_DSA_REALTEK=y
-CONFIG_NET_DSA_REALTEK_MDIO=y
-CONFIG_NET_DSA_REALTEK_SMI=y
-CONFIG_NET_DSA_REALTEK_RTL8365MB=y
-CONFIG_NET_DSA_REALTEK_RTL8366RB=y
+# CONFIG_NET_DSA is not set
 
 # Read-only rtl865x/RTL8367 diagnostics from the existing RTL8197F ethdiag module.
 CONFIG_RTL8197F_ETH_DIAG=y
@@ -365,3 +343,6 @@
 CONFIG_WEXT_PROC=y
 CONFIG_WEXT_PRIV=y
 CONFIG_WEXT_SPY=y
+
+# Tenda AC8 image size: no eBPF programs (the firewall is nftables).
+# CONFIG_BPF_SYSCALL is not set
