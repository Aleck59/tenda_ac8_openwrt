# Sources of the OpenWrt 19.07 / Linux 4.14 build, pinned so that builds are
# reproducible and the patches in patches/ keep applying.
#
# OpenWrt 19.07 and its feeds at the revisions of the HH71VM port.
OPENWRT_REPO=https://github.com/openwrt/openwrt.git
OPENWRT_COMMIT=1da2e82c1182a3fd681da5760be96821213afadd
PACKAGES_REPO=https://github.com/openwrt/packages.git
PACKAGES_COMMIT=6df6880800397ab3821572c6c5ad18e300374d9e
LUCI_REPO=https://github.com/openwrt/luci.git
LUCI_COMMIT=f25285a6c26e8776f153994704710cb8e51fad91

# The rtkmipsel target for the RTL8197F (Linux 4.14: arch code, rtknet
# Ethernet, rtl8192cd Wi-Fi, SPI flash) of the Alcatel LINKHUB HH71VM port.
HH71VM_REPO=https://github.com/sowarden/hh71vm-openwrt.git
HH71VM_COMMIT=8881e78d64fef8a7ccbce472d35803ea2f1f3a90

# The Realtek SDK RTL8367RB driver (rtl8367r/, rtl8367b_* API, the one of the
# stock AC8 firmware) from the OpenWrt 18.06 fork for the Tenda AC10U.
AC10_REPO=https://github.com/vladisslav2011/openwrt-AC10.git
AC10_COMMIT=370e6f795f0f96a83d1d2dcc642facb922df37ce
