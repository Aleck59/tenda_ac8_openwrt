// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Tenda AC8 v1: RTL8197FH (MIPS 24Kc, 2.4 GHz radio) + RTL8812FR (PCIe,
 * 5 GHz) + RTL8367RB gigabit switch, SPI-NOR flash.
 *
 * Known facts (stock AC8 V2.0 eCos firmware V03.03.10.01, v1 is assumed to
 * use the same layout):
 *   - image header "cs6c", startAddr 0x80700000, burnAddr 0x00020000,
 *     so the boot loader occupies 0x000000..0x020000 and the firmware
 *     starts at 0x020000;
 *   - the firmware carries RTL8812F PHY tables and rtl8367b/rtl8367c
 *     switch helpers.
 *
 * Verified by a boot log from a real AC8 v1 with an 8 MiB chip:
 *   - the boot loader starts the cs6c image at 0x20000 (loader at
 *     0x80a00000, relocated to 0x81000000);
 *   - RTL8367RB-VB (id 0x6367, ver 0x0020) answers on SMI with
 *     MDC = GPIO H0 = 56, MDIO = GPIO G7 = 55, CPU port link comes up;
 *   - byte reads through the SPI auto-map window are NOT shifted (raw
 *     bytes at 0x60000/0x350000 match the flashed image), unlike RD05.
 *
 * NOT verified on hardware (taken from the Tenda AC23 profile of the
 * RTL8197F port, which uses the same RTL8197FH + RTL8367RB design, and
 * from the Xiaomi RD05 profile for the SoC side of the link):
 *   - Ethernet with rtknet + the swconfig rtl8367b driver and an 802.1Q
 *     trunk (rtknet + rtl8365mb DSA passed traffic both ways with a static
 *     address, but stopped after a cable replug; the rtl819x driver of the
 *     D-Link DIR-842 R1 port sent nothing to the switch);
 *   - switch port to front-panel jack mapping;
 *   - RAM size (64 MiB declared, the chip may have 128 MiB);
 *   - the SYS LED and the button (GPIOs from the code of the stock AC8 v1
 *     eCos firmware, see the leds node);
 *   - the location of the Tenda config block at the end of the flash.
 *
 * The stock 4 MiB profile exports the flash read-only.  The 8/16 MiB
 * profiles open the firmware partition for writes (sysupgrade, JFFS2
 * overlay in rootfs_data); the boot loader area stays read-only.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "rtl8197f.dtsi"

/ {
	aliases {
		serial0 = &uart0;
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 lpj=5000000 rootfstype=squashfs clk_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	/* Conservative value, see the header comment. */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	/*
	 * GPIOs from the code of the stock eCos firmware of the AC8 v1 (Realtek
	 * numbering A0 = 0).  Its GPIO init sets up only E3 (output, high) and
	 * E4 (input).  E3 is the system LED: the "single_led" thread blinks it
	 * and wps_led_on/off drive it too, low = on.  E4 is the WPS/RST button:
	 * the "reset" (held) and "wps" (short press) entries of its button table
	 * both poll it, low = pressed.  The sys_led=gpio6/wps_led=gpio7/
	 * reset_gpio=20 defaults in its NVRAM are never used.  WLAN on E1 is
	 * verified on the AC8 (rightmost LED).  The port LEDs belong to the
	 * RTL8367RB (realtek,rtl8197f-ac8-oem-init).
	 */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		led_sys: led-0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 35 GPIO_ACTIVE_LOW>;	/* E3 */
		};

		led-1 {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 33 GPIO_ACTIVE_LOW>;	/* E1 */
		};
	};

	/* Polled: the GPIO block is not an interrupt controller here. */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;
		pinctrl-names = "default";
		pinctrl-0 = <&button_pins>;

		reset {
			label = "reset";
			gpios = <&gpio0 36 GPIO_ACTIVE_LOW>;	/* E4, WPS/RST */
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	/*
	 * RTL8367RB-VB (chip id 0x6367, ver 0x0020), swconfig rtl8367b driver
	 * of OpenWrt 24.10 (as on the TP-Link Archer C2 v1), which resets the
	 * chip and runs the RTL8367C init like the stock rtk_switch_init().
	 * realtek,extif: CPU port 6 = EXT1, RGMII delays tx 0 / rx 5 (the
	 * values the stock switch init ends with), RGMII, forced 1000/full,
	 * pause off.
	 * realtek,rtl8197f-ac8-oem-init: the rest of the stock init (port LED
	 * pins and mode, thresholds, SSC).  Port 6 is a tagged member of
	 * VLAN 1 (WAN, port 4) and VLAN 2 (LAN, ports 0-3), see 02_network.
	 */
	rtl8367b {
		compatible = "realtek,rtl8367b";
		pinctrl-names = "default";
		pinctrl-0 = <&rtl8367_smi_h0_g7_pins>;
		realtek,extif = <6 0 5 1 1 0 0 1 1 2>;
		gpio-sck = <&gpio0 56 GPIO_ACTIVE_HIGH>;	/* H0, MDC */
		gpio-sda = <&gpio0 55 GPIO_ACTIVE_HIGH>;	/* G7, MDIO */
		realtek,rtl8197f-ac8-oem-init;
	};
};

&pinmux {
	rtl8367_smi_h0_g7_pins: rtl8367-smi-h0-g7-pins {
		pinctrl-single,bits = <0x34 0x03300000 0x0ff00000>;
	};

	/*
	 * GPIO function of the pins, the values of the pin mux helper of the
	 * stock firmware (the same as in the Realtek 8197F BSP, gpio.c).
	 */
	led_pins: led-pins {
		pinctrl-single,bits = <0x44 0x00100000 0x00f00000>,	/* E3 */
				      <0x44 0x10000000 0xf0000000>;	/* E1 */
	};

	button_pins: button-pins {
		pinctrl-single,bits = <0x44 0x00010000 0x000f0000>;	/* E4 */
	};
};

&gpio0 {
	/delete-property/ interrupt-controller;
	/delete-property/ #interrupt-cells;
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
	status = "okay";
};

&uart0 {
	/* Polling mode, as on the other RTL8197F boards of the port. */
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
};

&spi0 {
	status = "disabled";
};

&spirom0 {
	status = "okay";
	erase-size = <0x10000>;
	/*
	 * No read shift on the AC8: with the RD05 value of 1 every read was
	 * off by one byte, the rtl8197f-fw parser saw "\xffcs6" instead of
	 * the cs6c header and no rootfs partition was created.
	 */
	realtek,read-shift = <0>;

	/*
	 * The flash size, the partition table and the writable window
	 * (realtek,writable-offset/size) are set per flash chip.
	 */
};

&ethdiag0 {
	status = "disabled";
};

/*
 * rtknet, the CPU-port driver of this RTL8197F tree, which initialises the
 * CPU interface and the switch-core tables itself (the loader gates the
 * switch-core clock before it jumps to the kernel, so nothing of its setup
 * survives) and sends every frame straight to physical P0.  It passed
 * traffic both ways on the AC8 with the DSA builds.  The trunk to the
 * RTL8367 carries plain 802.1Q frames (VLAN 1 WAN, VLAN 2 LAN; swconfig,
 * as on the TP-Link Archer C2 v1): no CPU tag on either side.  RGMII: the
 * values of the stock init_8197f_p0 (CF_SEL_RGTXC 3, which rtknet always
 * sets, TX delay 0, RX delay 7) against the stock switch EXT1 side (tx 0,
 * rx 5).  Runtime parameters: /sys/module/rtl8197f_rtknet/parameters/
 * rd05_p0_{tx,rx}_delay, applied with "echo reseed > /proc/rd05-rtknet"
 * (ac8-trunk does both).
 */
&ethernet0 {
	realtek,tx-port-mask = <0x1>;
	realtek,tx-dp-ext = <0x0>;
	realtek,tx-extspa = <0x0>;
	realtek,rx-poll-fallback;
	realtek,rx-poll-ms = <50>;
	realtek,sdk-cpuicr1-init;
	realtek,sdk-swcore-init;
	realtek,sdk-trxrdy;
	/* SoC-side VID9/L2/netif host-link seed for P0. */
	realtek,legacy-rd05-sdk-pipeline;
	realtek,p0-cpu-tag-pass-through;
	/* Descriptor lengths include the FCS, as in the Realtek SDK. */
	realtek,sdk-crc-lengths;
	realtek,p0-rgmii-tx-delay = <0>;
	realtek,p0-rgmii-rx-delay = <7>;
	status = "okay";
};

&pcie0 {
	/*
	 * RTL8812F (10ec:f812), the 5 GHz radio.  Like the stock firmware,
	 * the driver takes the reference clock from the strap (CLK_DETECT
	 * bit 24) and does not apply the RTL8197F-VG PHY tuning.
	 */
	status = "okay";
};

/* The integrated 2.4 GHz radio of the RTL8197FH. */
&wlan {
	status = "okay";
};
