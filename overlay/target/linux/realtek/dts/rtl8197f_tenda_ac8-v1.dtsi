// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Tenda AC8 v1: RTL8197FH (MIPS 24Kc, 2.4 GHz radio) + RTL8812FR (PCIe,
 * 5 GHz) + RTL8367RB gigabit switch, SPI-NOR flash.
 *
 * Known facts (stock AC8 V2.0 eCos firmware V03.03.10.01, v1 is assumed to
 * use the same layout):
 *   - image header "cs6c", startAddr 0x80700000, burnAddr 0x00020000,
 *     so the boot loader occupies 0x000000..0x020000 and the firmware
 *     starts at 0x020000;
 *   - the firmware carries RTL8812F PHY tables and rtl8367b/rtl8367c
 *     switch helpers.
 *
 * Verified by a boot log from a real AC8 v1 with an 8 MiB chip:
 *   - the boot loader starts the cs6c image at 0x20000 (loader at
 *     0x80a00000, relocated to 0x81000000);
 *   - RTL8367RB-VB (id 0x6367, ver 0x0020) answers on SMI with
 *     MDC = GPIO H0 = 56, MDIO = GPIO G7 = 55, CPU port link comes up;
 *   - byte reads through the SPI auto-map window are NOT shifted (raw
 *     bytes at 0x60000/0x350000 match the flashed image), unlike RD05.
 *
 * NOT verified on hardware (taken from the Tenda AC23 profile of the
 * RTL8197F port, which uses the same RTL8197FH + RTL8367RB design, and
 * from the Xiaomi RD05 profile for the SoC side of the link):
 *   - WAN traffic (LAN verified: LuCI reachable with the delays and the
 *     rtl8_4t tag chosen by ac8-ethtest);
 *   - switch port to front-panel jack mapping;
 *   - RAM size (64 MiB declared, the chip may have 128 MiB);
 *   - SYS/WPS LEDs and the button (GPIOs from the stock AC8 v1 eCos
 *     defaults, see the leds node);
 *   - the location of the Tenda config block at the end of the flash.
 *
 * The stock 4 MiB profile exports the flash read-only.  The 8/16 MiB
 * profiles open the firmware partition for writes (sysupgrade, JFFS2
 * overlay in rootfs_data); the boot loader area stays read-only.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "rtl8197f.dtsi"

/ {
	aliases {
		serial0 = &uart0;
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 lpj=5000000 rootfstype=squashfs clk_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	/* Conservative value, see the header comment. */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	/*
	 * GPIOs from the defaults of the stock eCos firmware of the AC8 v1
	 * (sys_led=gpio6, wps_led=gpio7, wps_button=gpio20, reset_gpio=20;
	 * Realtek numbering A0 = 0): SYS on A6, WPS on A7, the WPS/RST button on
	 * C4.  WLAN on E1 (its wireless driver drives it on the stock firmware)
	 * is verified on the AC8.  The polarity of A6/A7 is not verified.  The
	 * port LEDs belong to the RTL8367RB (realtek,rtl8197f-ac8-oem-init).
	 */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		led_sys: led-0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;	/* A6 */
		};

		led-1 {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;	/* A7 */
		};

		led-2 {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 33 GPIO_ACTIVE_LOW>;	/* E1 */
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&button_pins>;

		reset {
			label = "reset";
			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;	/* C4, WPS/RST */
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	rtl8367_smi: switch {
		compatible = "realtek,rtl8367rb", "realtek,rtl8367rb-vc", "realtek,rtl8365mb";
		pinctrl-names = "default";
		pinctrl-0 = <&rtl8367_smi_h0_g7_pins>;
		mdc-gpios = <&gpio0 56 GPIO_ACTIVE_HIGH>;  /* SDK H0 */
		mdio-gpios = <&gpio0 55 GPIO_ACTIVE_HIGH>; /* SDK G7 */
		/* rtk_switch_init() of the stock firmware: port LEDs, thresholds, SSC */
		realtek,rtl8197f-ac8-oem-init;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * The AC8 has 1 WAN + 3 LAN jacks on a 5-PHY switch.  All five
			 * PHYs are published so the real mapping can be found from the
			 * link state; one of lan1..lan4 has no jack.
			 */
			port@0 { reg = <0>; label = "lan1"; phy-handle = <&swphy0>; };
			port@1 { reg = <1>; label = "lan2"; phy-handle = <&swphy1>; };
			port@2 { reg = <2>; label = "lan3"; phy-handle = <&swphy2>; };
			port@3 { reg = <3>; label = "lan4"; phy-handle = <&swphy3>; };
			port@4 { reg = <4>; label = "wan";  phy-handle = <&swphy4>; };

			/* EXT1 of the RTL8367RB-VB, RGMII peer of RTL8197F P0. */
			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&ethernet0>;
				phy-mode = "rgmii";
				/*
				 * Found with ac8-ethtest on a real AC8 v1: frames from
				 * the SoC only pass with the trailer tag (with the
				 * header tag the switch drops them) and with switch RX
				 * delay 3 (0.9 ns) against P0 TX delay 1, see
				 * &ethernet0.  Both delays can be changed at run time
				 * through /sys/module/rtl8365mb/parameters/
				 * ext_rgmii_{tx,rx}_delay.
				 */
				dsa-tag-protocol = "rtl8_4t";
				tx-internal-delay-ps = <0>;
				rx-internal-delay-ps = <900>;

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
				};
			};
		};

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			swphy0: ethernet-phy@0 { reg = <0>; eee-broken-100tx; eee-broken-1000t; };
			swphy1: ethernet-phy@1 { reg = <1>; eee-broken-100tx; eee-broken-1000t; };
			swphy2: ethernet-phy@2 { reg = <2>; eee-broken-100tx; eee-broken-1000t; };
			swphy3: ethernet-phy@3 { reg = <3>; eee-broken-100tx; eee-broken-1000t; };
			swphy4: ethernet-phy@4 { reg = <4>; eee-broken-100tx; eee-broken-1000t; };
		};
	};
};

&pinmux {
	rtl8367_smi_h0_g7_pins: rtl8367-smi-h0-g7-pins {
		pinctrl-single,bits = <0x34 0x03300000 0x0ff00000>;
	};

	/* GPIO function of the pins, values from the Realtek 8197F BSP (gpio.c). */
	led_pins: led-pins {
		pinctrl-single,bits = <0x00 0x00050000 0x000f0000>,	/* A6 */
				      <0x00 0x00600000 0x00f00000>,	/* A7 */
				      <0x44 0x10000000 0xf0000000>;	/* E1 */
	};

	button_pins: button-pins {
		pinctrl-single,bits = <0x40 0x00020000 0x000f0000>;	/* C4 */
	};
};

&gpio0 {
	/delete-property/ interrupt-controller;
	/delete-property/ #interrupt-cells;
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
	status = "okay";
};

&uart0 {
	/* Polling mode, as on the other RTL8197F boards of the port. */
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
};

&spi0 {
	status = "disabled";
};

&spirom0 {
	status = "okay";
	erase-size = <0x10000>;
	/*
	 * No read shift on the AC8: with the RD05 value of 1 every read was
	 * off by one byte, the rtl8197f-fw parser saw "\xffcs6" instead of
	 * the cs6c header and no rootfs partition was created.
	 */
	realtek,read-shift = <0>;

	/*
	 * The flash size, the partition table and the writable window
	 * (realtek,writable-offset/size) are set per flash chip.
	 */
};

&ethdiag0 {
	status = "disabled";
};

/*
 * Same datapath as the Xiaomi RD05 of the port (RTL8197FH-VG, external
 * RTL8367 on physical P0/RGMII, rtl8_4 tag in Linux DSA); rtknet treats
 * tenda,ac8-v1 as an RD05-class board.  DMA TX goes straight to P0
 * (DP bit 0); DP bit 6 with DP_EXT=2 is the internal extension path and
 * never reaches the RTL8367RB.
 */
&ethernet0 {
	realtek,tx-port-mask = <0x1>;
	realtek,tx-dp-ext = <0x0>;
	realtek,tx-extspa = <0x0>;
	realtek,rx-poll-fallback;
	realtek,rx-poll-ms = <50>;
	realtek,sdk-cpuicr1-init;
	realtek,sdk-swcore-init;
	realtek,sdk-trxrdy;
	/* SoC-side VID9/L2/netif host-link seed for P0. */
	realtek,legacy-rd05-sdk-pipeline;
	realtek,p0-cpu-tag-pass-through;
	/* Descriptor lengths include the FCS, as in the Realtek SDK. */
	realtek,sdk-crc-lengths;
	/*
	 * P0 RGMII delays found with ac8-ethtest (TX delay on, RX tap 6).
	 * Runtime parameters: /sys/module/rtl8197f_rtknet/parameters/
	 * rd05_p0_{tx,rx}_delay.
	 */
	realtek,p0-rgmii-tx-delay = <1>;
	realtek,p0-rgmii-rx-delay = <6>;
	status = "okay";
};

&pcie0 {
	/*
	 * RTL8812F (10ec:f812), the 5 GHz radio.  Like the stock firmware,
	 * the driver takes the reference clock from the strap (CLK_DETECT
	 * bit 24) and does not apply the RTL8197F-VG PHY tuning.
	 */
	status = "okay";
};

/* The integrated 2.4 GHz radio of the RTL8197FH. */
&wlan {
	status = "okay";
};
