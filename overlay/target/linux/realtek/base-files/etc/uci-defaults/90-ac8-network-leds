#!/bin/sh
# Tenda AC8 v1: move settings kept from builds up to ac8-20260924-13.
#
# - Those builds put LAN and WAN into one VLAN-filtering bridge "switch"
#   (lan = switch.1 with the LAN ports listed twice, wan = switch.2).  A
#   network config still in exactly that default shape becomes the usual
#   br-lan (lan1..lan4) + wan.
# - Their LED defaults named blue:wan and blue:lan, which the AC8 does not
#   have (the WAN/LAN LEDs belong to the switch chip).

. /lib/functions.sh

case "$(board_name)" in
tenda,ac8-v1*) ;;
*) exit 0 ;;
esac

if [ "$(uci -q get network.lan.device)" = "switch.1" ] &&
   [ "$(uci -q get network.wan.device)" = "switch.2" ] &&
   [ "$(uci -q get network.switch.type)" = "bridge" ]; then
	ports=
	for p in $(uci -q get network.lan_vlan.ports); do
		p=${p%%:*}
		case " $ports " in *" $p "*) ;; *) ports="$ports $p" ;; esac
	done
	[ -n "$ports" ] || ports="lan1 lan2 lan3 lan4"

	# MAC address sections config_generate made for switch.1/switch.2
	lan_mac= wan_mac=
	drop_devices() {
		local name
		config_get name "$1" name
		case "$name" in
		switch.1) config_get lan_mac "$1" macaddr; uci -q delete "network.$1" ;;
		switch.2) config_get wan_mac "$1" macaddr; uci -q delete "network.$1" ;;
		esac
	}
	config_load network
	config_foreach drop_devices device

	uci -q batch >/dev/null <<-EOF
		delete network.lan_vlan
		delete network.wan_vlan
		delete network.switch
		add network device
		set network.@device[-1].name='br-lan'
		set network.@device[-1].type='bridge'
		set network.lan.device='br-lan'
		set network.wan.device='wan'
	EOF
	for p in $ports; do
		uci add_list network.@device[-1].ports="$p"
	done
	[ -n "$lan_mac" ] && uci set network.@device[-1].macaddr="$lan_mac"
	if [ -n "$wan_mac" ]; then
		uci -q batch >/dev/null <<-EOF
			add network device
			set network.@device[-1].name='wan'
			set network.@device[-1].macaddr='$wan_mac'
		EOF
	fi
	[ "$(uci -q get network.wan6.device)" = "switch.2" ] &&
		uci set network.wan6.device='wan'
	uci commit network
fi

drop_leds() {
	local sysfs
	config_get sysfs "$1" sysfs
	case "$sysfs" in
	blue:wan|blue:lan) uci -q delete "system.$1" ;;
	esac
}
config_load system
config_foreach drop_leds led
uci commit system

exit 0
