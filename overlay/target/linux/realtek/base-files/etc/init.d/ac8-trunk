#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Apply the RGMII trunk delays saved by "ac8-trunk save" (Tenda AC8 v1).

START=15

start() {
	[ -f /etc/ac8-trunk.conf ] && [ -w /proc/rtl819x_trunk ] || return 0
	while read -r line; do
		case "$line" in
		soc\ *|sw\ *)
			echo "$line" > /proc/rtl819x_trunk ||
				logger -t ac8-trunk "rejected: $line"
			;;
		esac
	done < /etc/ac8-trunk.conf
	logger -t ac8-trunk "applied $(tr '\n' ' ' < /etc/ac8-trunk.conf)"
}
