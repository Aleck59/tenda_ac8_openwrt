#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Tenda AC8 v1 RGMII trunk (SoC P0 <-> RTL8367 port 6): apply the delays saved
# by "ac8-trunk save", then, once LAN is up, check the link and print the
# result on the serial console ("ac8-trunk boot").

START=15

start() {
	[ -w /proc/rtl819x_trunk ] || return 0
	if [ -f /etc/ac8-trunk.conf ]; then
		while read -r line; do
			case "$line" in
			soc\ *|sw\ *)
				echo "$line" > /proc/rtl819x_trunk ||
					logger -t ac8-trunk "rejected: $line"
				;;
			esac
		done < /etc/ac8-trunk.conf
		logger -t ac8-trunk "applied $(tr '\n' ' ' < /etc/ac8-trunk.conf)"
	fi
	(
		ubus -t 120 wait_for network.interface.lan 2>/dev/null
		sleep 15
		/usr/sbin/ac8-trunk boot >/dev/null 2>&1
	) </dev/null >/dev/null 2>&1 &
}
