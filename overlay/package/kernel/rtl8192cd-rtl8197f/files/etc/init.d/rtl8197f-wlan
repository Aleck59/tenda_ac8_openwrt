#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Load the experimental rtl8192cd Wi-Fi driver of the Tenda AC8 once the
# rest of the system (and LAN) is up, then let netifd set up the radios.
#
# Modes, tried in this order: "dual" (the integrated 2.4 GHz radio and the
# 5 GHz RTL8812F on PCIe), then "pcie" (5 GHz only).  A load, or a first
# bring-up of the enabled radios, that never finishes (oops, hang, watchdog
# reset) leaves $GUARD behind with its mode: the next boot adds that mode
# to $FAILED and uses the next one.  With every mode failed Wi-Fi stays
# off, so the router stays reachable over LAN.  To try again:
#
#	rm /etc/rtl8197f-wlan.failed; /etc/init.d/rtl8197f-wlan start

START=99

GUARD=/etc/rtl8197f-wlan.loading
FAILED=/etc/rtl8197f-wlan.failed
STAMP=/etc/rtl8197f-wlan.build
LOG=/tmp/rtl8197f-wlan-load.log
MODES="dual pcie"

# The kernel's console log level is 1 after boot: print the outcome on the
# serial console directly, and to the system log.
con() {
	echo "rtl8197f-wlan: $*" > /dev/console 2>/dev/null
	logger -t rtl8197f-wlan "$*"
}

report() {
	local l
	for l in $(sed -n 's/^\(init_phase\|last_phase\|init_rc\)=/&/p' "$LOG" 2>/dev/null); do
		con "driver: $l"
	done
	iw dev 2>/dev/null | grep -E '^phy|Interface|ssid|channel|type' |
		while read -r l; do con "iw: $l"; done
	ubus call network.wireless status 2>/dev/null |
		grep -E '"(radio[0-9]*|up|pending|autostart|disabled|retry_setup_failed)"|"errors"|^[[:space:]]*"[A-Z_]+",?$' |
		tr -d '\t,' | while read -r l; do con "status: $l"; done
	logread -e hostapd 2>/dev/null | tail -n 6 | while read -r l; do con "log: ${l#* * * * * }"; done
	dmesg | grep -iE 'rtl8192cd|8812f|8197f-w|phydm|halmac|wlan[01]' | tail -n 10 |
		while read -r l; do con "dmesg: $l"; done
}

start() {
	grep -q '^rtl8192cd ' /proc/modules && return 0

	# Failures recorded by another firmware build do not count.
	build=$(md5sum /proc/version 2>/dev/null | cut -c1-8)
	if [ -e "$FAILED" ] && [ "$(cat "$STAMP" 2>/dev/null)" != "$build" ]; then
		rm -f "$FAILED" "$GUARD"
		con "new firmware: forgetting the failed load modes of the previous one"
	fi
	echo "$build" > "$STAMP"

	if [ -e "$GUARD" ]; then
		# The builds up to ac8-20260925-15 left an empty guard.
		last=$(cat "$GUARD" 2>/dev/null)
		echo "${last:-dual}" >> "$FAILED"
		rm -f "$GUARD"
		con "the driver load in mode ${last:-dual} did not finish last boot, not trying that mode again"
	fi

	mode=
	for m in $MODES; do
		grep -qx "$m" "$FAILED" 2>/dev/null && continue
		mode=$m
		break
	done
	if [ -z "$mode" ]; then
		con "no driver load mode left ($(tr '\n' ' ' < "$FAILED")), Wi-Fi stays off; to retry: rm $FAILED; /etc/init.d/rtl8197f-wlan start"
		return 1
	fi
	con "loading the driver, mode $mode"

	(
		echo "$mode" > "$GUARD"
		sync
		/usr/sbin/rtl8197f-wlan-load --"$mode" >"$LOG" 2>&1
		rc=$?
		# Killed by an oops, or stuck in its init: not this mode again.
		if [ "$rc" -ge 128 ] || grep -q '^rtl8192cd .* Loading ' /proc/modules; then
			echo "$mode" >> "$FAILED"
			rm -f "$GUARD"
			sync
			rc=1
		fi
		con "driver load ($mode) finished with rc=$rc, full log in $LOG"
		if [ "$rc" != 0 ]; then
			rm -f "$GUARD"
			sync
			report
			exit 0
		fi

		# The phys appeared after netifd started: add them to
		# /etc/config/wireless (new radios start disabled) and bring
		# up the enabled ones.  The hardware of a radio is set up
		# (firmware, calibration) when it goes up: keep $GUARD until
		# that is over, so a crash there does not repeat every boot.
		sleep 2
		/sbin/wifi config
		/sbin/wifi up
		sleep 30
		if dmesg | grep -qE 'Oops|Unable to handle kernel|BUG: '; then
			echo "$mode" >> "$FAILED"
			con "kernel oops while the radios came up, mode $mode will not be used again"
		fi
		rm -f "$GUARD"
		sync
		report
	) </dev/null >/dev/null 2>&1 &
}
