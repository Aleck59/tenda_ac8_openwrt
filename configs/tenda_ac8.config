CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_tenda_ac8-v1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_KERNEL_DEVTMPFS=y
CONFIG_KERNEL_DEVTMPFS_MOUNT=y
# CONFIG_KERNEL_KALLSYMS is not set
CONFIG_PACKAGE_kmod-rtl8192cd=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
# Wi-Fi: WPA2/WPA3-Personal (SAE), 802.11w, 802.11k/v
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_WPA_MSG_MIN_PRIORITY=3
# WAN: PPPoE (+ DHCP/static from the base system)
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y
# Web interface with HTTPS, Footstrap theme, Russian translation
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_LUCI_LANG_ru=y
# 64 MiB RAM: compressed swap in RAM
CONFIG_PACKAGE_zram-swap=y
