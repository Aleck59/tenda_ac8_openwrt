CONFIG_TARGET_rtkmipsel=y
CONFIG_TARGET_rtkmipsel_rtl8197f=y
CONFIG_TARGET_rtkmipsel_rtl8197f_tenda_ac8=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_KERNEL_BUILD_USER="openwrt"
CONFIG_KERNEL_BUILD_DOMAIN="build"
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
# Wi-Fi: vendor driver + wireless extensions (iwpriv), no hostapd
CONFIG_PACKAGE_kmod-rtl8192cd=y
CONFIG_PACKAGE_wireless-tools=y
# CONFIG_PACKAGE_wpad-mini is not set
# CONFIG_PACKAGE_wpad-basic is not set
# LuCI with the Russian translation
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_ru=y
# HTTPS for opkg
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_ca-bundle=y
